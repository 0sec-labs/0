# Copy to .env (never commit it). Used by docker-compose.yml.

# Access token for the web console, 32+ characters:  openssl rand -base64 32
# Leave empty to let the first start generate one (printed once in `docker compose logs zero`,
# stored 0600 at /data/.0/access-token).
ZERO_ACCESS_TOKEN=

# Host names the console answers to, comma separated. Anything else gets 403.
ZERO_ALLOWED_HOSTS=localhost,127.0.0.1

# With the proxy profile: your DNS name, the public URL, and the allowed host (all three must match).
# ZERO_DOMAIN=0.example.com
# ZERO_PUBLIC_URL=https://0.example.com
# ZERO_ALLOWED_HOSTS=0.example.com

# Pin a release instead of following main builds.
# ZERO_IMAGE_TAG=v0.39.0

# Model provider keys, only the ones you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# GEMINI_API_KEY=

# GitHub access for pull request reviews: a fine-grained token limited to the repositories you review
# (Contents: read, Pull requests: read, Metadata: read). Or run `docker compose exec -it zero gh auth login` once.
# GH_TOKEN=

# Optional.
# ZERO_NO_TELEMETRY=1
# ZERO_PORT=48123
