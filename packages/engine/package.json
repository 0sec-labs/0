{
  "name": "@0/engine",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    },
    "./config/deprecated-env": {
      "types": "./dist/config/deprecated-env.d.ts",
      "import": "./dist/config/deprecated-env.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "generate-skills": "node scripts/generate-skills-manifest.mjs",
    "build": "node scripts/generate-skills-manifest.mjs && tsc && node scripts/copy-build-assets.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "sync-pricing": "tsx scripts/sync-pricing.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "node-sqlite3-wasm": "^0.8.61",
    "pdfkit": "^0.20.2",
    "tree-sitter": "file:../../vendor/tree-sitter-0.21.1-node24.tgz",
    "tree-sitter-c": "0.21.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
