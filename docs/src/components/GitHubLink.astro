---
import { GITHUB_REPO, GITHUB_URL } from './links';
---

<a class="docs-github" href={GITHUB_URL} rel="me noopener" data-gh-repo={GITHUB_REPO}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
  <span class="docs-github-label">GitHub</span>
  <span class="docs-github-stars" data-gh-stars hidden>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
    <span data-gh-star-count></span><span class="sr-only"> stars</span>
  </span>
</a>

<script>
  // Progressive enhancement: show the live star count, cached for an hour.
  const KEY = 'docs-gh-stars';
  const format = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));
  const paint = (count: number) => {
    document.querySelectorAll<HTMLElement>('[data-gh-stars]').forEach((el) => {
      const slot = el.querySelector('[data-gh-star-count]');
      if (slot) slot.textContent = format(count);
      el.hidden = false;
    });
  };
  try {
    const cached = JSON.parse(sessionStorage.getItem(KEY) || 'null');
    if (cached && Date.now() - cached.at < 3_600_000) paint(cached.count);
    else {
      const repo = document.querySelector<HTMLElement>('[data-gh-repo]')?.dataset.ghRepo;
      if (repo) fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: 'application/vnd.github+json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          if (typeof data?.stargazers_count !== 'number') return;
          sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), count: data.stargazers_count }));
          paint(data.stargazers_count);
        })
        .catch(() => {});
    }
  } catch {}
</script>
