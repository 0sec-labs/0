---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
---

{Astro.url.pathname !== '/' ? <DefaultHero /> : (
  <section class="docs-hero" aria-labelledby="_top">
    <div class="docs-hero-copy">
      <span class="docs-preview-label">Research Preview</span>
      <h1 id="_top" data-page-title>Your multi-model,<br />open-source cybersecurity team.</h1>
      <p>Install 0, connect your models, hack &amp; fix your systems.</p>
      <div class="docs-hero-actions">
        <LinkButton href="/getting-started/" icon="right-arrow">Get started</LinkButton>
        <LinkButton href="/getting-started/#hosted-models" variant="secondary">Hosted inference</LinkButton>
        <LinkButton href="/getting-started/#use-my-own-api-key" variant="secondary">Use my own API key</LinkButton>
      </div>
    </div>
  </section>
)}
