---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
---

{Astro.url.pathname !== '/' ? <DefaultHero /> : (
  <section class="docs-hero" aria-labelledby="_top">
    <div class="docs-hero-copy">
      <span class="docs-preview-label">Research Preview</span>
      <h1 id="_top" data-page-title>Your multi-model, self-improving<br />open-source cybersecurity team.</h1>
      <p>Install 0, connect your models, hack &amp; fix your systems.</p>
      <div class="docs-hero-actions">
        <LinkButton href="https://github.com/0sec-labs/0#quick-start" icon="right-arrow">Get started</LinkButton>
        <LinkButton href="/automations/" variant="secondary">Automations</LinkButton>
        <LinkButton href="/api-keys/" variant="secondary">Use my own API key</LinkButton>
      </div>
    </div>
  </section>
)}
