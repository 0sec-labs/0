theory LocalCaches
begin

// One issued bearer ticket, two nodes, one local consume slot per node.
// This models application replay policy, not TLS handshakes or cryptography.
rule Issue:
  [ Fr(~ticket) ]
  --[ Init() ]->
  [ Unused('a', ~ticket), Unused('b', ~ticket), Out(~ticket) ]

rule Accept:
  [ Unused(node, ticket), In(ticket) ]
  --[ Accept(node, ticket) ]->
  [ ]

restriction OneIssue:
  "All #i #j. Init() @ i & Init() @ j ==> #i = #j"

lemma distributed_replay_exists: exists-trace
  "Ex ticket #i #j. Accept('a', ticket) @ i & Accept('b', ticket) @ j & not (#i = #j)"

lemma at_most_once:
  "All a b ticket #i #j. Accept(a, ticket) @ i & Accept(b, ticket) @ j ==> #i = #j"

end
