theory LocalCaches

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Issue:
   [ Fr( ~ticket ) ]
  --[ Init( ) ]->
   [ Unused( 'a', ~ticket ), Unused( 'b', ~ticket ), Out( ~ticket ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Accept:
   [ Unused( node, ticket ), In( ticket ) ]
  --[ Accept( node, ticket ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction OneIssue:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((Init( ) @ #i) ∧ (Init( ) @ #j)) ⇒ (#i = #j)"
  */

lemma distributed_replay_exists:
  exists-trace
  "∃ ticket #i #j.
    ((Accept( 'a', ticket ) @ #i) ∧ (Accept( 'b', ticket ) @ #j)) ∧
    (¬(#i = #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ ticket #i #j.
  (Accept( 'a', ticket ) @ #i) ∧ (Accept( 'b', ticket ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Unused( 'a', ticket ) ▶₀ #i )
    case Issue
    solve( Unused( 'b', ~ticket ) ▶₀ #j )
      case Issue
      solve( !KU( ~ticket ) @ #vk )
        case Issue
        SOLVED // trace found
      qed
    qed
  qed
qed

lemma at_most_once:
  all-traces
  "∀ a b ticket #i #j.
    ((Accept( a, ticket ) @ #i) ∧ (Accept( b, ticket ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ a b ticket #i #j.
  (Accept( a, ticket ) @ #i) ∧ (Accept( b, ticket ) @ #j) ∧ ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( Unused( a, ticket ) ▶₀ #i )
    case Issue_case_1
    solve( Unused( b, ~ticket ) ▶₀ #j )
      case Issue_case_2
      solve( !KU( ~ticket ) @ #vk )
        case Issue
        SOLVED // trace found
      qed
    qed
  qed
qed

