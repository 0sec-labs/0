{
  "name": "0sec-cli",
  "type": "module",
  "version": "0.21.4",
  "description": "Your self-improving, open-source cybersecurity team.",
  "bin": {
    "0": "dist/0.js"
  },
  "files": [
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "README.md",
    "package.json",
    "dist"
  ],
  "scripts": {
    "build": "pnpm -r exec rm -f tsconfig.tsbuildinfo && pnpm --filter @0/shared build && pnpm --filter @0/db --filter @0/templates build && pnpm --filter '!@0/docs' -r build && pnpm run build:bundle",
    "build:bundle": "node ./scripts/bundle-cli.mjs",
    "build:docs": "pnpm --filter @0/docs build",
    "docs:check": "node scripts/sync-cli-docs.mjs --check",
    "docs:sync": "node scripts/sync-cli-docs.mjs --write",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm --filter '!@0/docs' -r exec tsc --noEmit",
    "test": "pnpm test:public",
    "test:public": "pnpm --filter @0/core test && pnpm --filter @0/test-targets test && pnpm --filter @0/cli test && pnpm test:runtime-lock && pnpm test:bundle-skills && pnpm test:public-source-export && pnpm test:dev-engine && node --test scripts/dsh-0-mcp.test.mjs && pnpm test:docs-pointers",
    "test:bundle-skills": "node --test scripts/bundle-skills-assets.test.mjs",
    "test:dsh-mcp:e2e": "node scripts/dsh-0-mcp.e2e.mjs",
    "test:install-e2e": "bash scripts/install-e2e.sh",
    "test:cloud-e2e": "bash scripts/smoke-cloud-account.sh",
    "test:evolution:e2e": "node scripts/smoke-source-evolution.mjs && node scripts/smoke-lens-evolution.mjs && node scripts/smoke-codebase-learning.mjs && node scripts/smoke-source-citation.mjs",
    "test:smolvm:e2e": "node scripts/smoke-smolvm.mjs",
    "test:smolvm:toolbox": "node scripts/smoke-smolvm-toolbox.mjs",
    "test:docs-pointers": "node --test scripts/docs-code-pointers.test.mjs",
    "test:runtime-lock": "node --test scripts/runtime-lock.test.mjs",
    "test:dev-engine": "node --test scripts/build-dev-engine.test.mjs",
    "test:public-source-export": "node --test scripts/create-public-source-export.test.mjs",
    "export:public-source": "node scripts/create-public-source-export.mjs",
    "bench": "pnpm --filter @0/benchmark bench",
    "bench:quick": "pnpm --filter @0/benchmark bench:quick",
    "consolidate-xbow": "pnpm --filter @0/benchmark consolidate-xbow",
    "clean": "pnpm -r clean",
    "vulnerable": "PORT=43100 pnpm --filter @0/test-targets vulnerable",
    "safe": "PORT=43101 pnpm --filter @0/test-targets safe"
  },
  "keywords": [
    "security",
    "cybersecurity",
    "application-security",
    "penetration-testing",
    "red-team",
    "vulnerability-scanner",
    "ai-security",
    "llm-security",
    "llm",
    "prompt-injection",
    "mcp",
    "owasp",
    "sast",
    "fuzzing",
    "binary-analysis",
    "autonomous-agents",
    "security-research"
  ],
  "author": "0.security",
  "homepage": "https://0.security",
  "bugs": {
    "url": "https://0.security/contact"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0sec-labs/0.git"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "drizzle-orm": "^0.45.2",
    "node-sqlite3-wasm": "^0.8.55",
    "pdfkit": "^0.15.2",
    "react": "^19.2.4",
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.21.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "^0.28.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "brace-expansion": "^5.0.9",
      "js-yaml": "^4.3.2",
      "smol-toml": "^1.7.1",
      "svgo": "^4.0.2",
      "ip-address": "^10.2.1",
      "nanoid@<3.3.18": "3.3.18",
      "devalue@<5.9.2": "^5.9.2",
      "hono": "^4.13.5",
      "@hono/node-server": "^1.19.15",
      "dompurify": "^3.4.13",
      "mermaid": "^11.16.1",
      "postcss": "^8.5.18",
      "fast-uri": "^3.1.3",
      "shell-quote": "^1.9.0",
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.3.0",
      "qs": "^6.16.0",
      "browserslist": "^4.28.8",
      "postcss-selector-parser@^6.0.0": "6.1.3",
      "postcss-selector-parser@^7.0.0": "^7.1.6"
    }
  }
}
