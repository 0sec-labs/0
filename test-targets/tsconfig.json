{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/scan.test.ts", "src/cli.test.ts"]
}
